[Unit]
Description=Update Cloudflare A record with current public IP
Wants=network-online.target
After=network-online.target
Before=bedrock.service
OnFailure=mc-alert@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/mc-ondemand.env
ExecStart=/usr/local/bin/cloudflare-update.sh

[Install]
WantedBy=multi-user.target
